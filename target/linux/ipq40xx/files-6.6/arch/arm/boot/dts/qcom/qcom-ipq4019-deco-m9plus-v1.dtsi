#include "qcom-ipq4019.dtsi"
#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/input/input.h>
#include <dt-bindings/soc/qcom,tcsr.h>
#include <dt-bindings/leds/common.h>
/ {
	chosen {
		bootargs-append = " clk_ignore_unused";
	};

	aliases {
		led-boot = &led_blue;
		led-failsafe = &led_red;
		led-running = &led_green;
		led-upgrade = &led_red;
		label-mac-device = &swport4;
	};

	keys {
		compatible = "gpio-keys";
		reset {
			label = "reset";
			gpios = <&tlmm 18 GPIO_ACTIVE_LOW>;
			linux,code = <KEY_RESTART>;
		};
	};

	soc {
		qcom,msm_qpic@7980000 {
			status = "ok";
		};
		tcsr@194b000 {
			compatible = "qcom,tcsr";
			reg = <0x194b000 0x100>;
			qcom,usb-hsphy-mode-select = <TCSR_USB_HSPHY_HOST_MODE>;
			status = "okay";
		};
		tcsr@1949000 {
			compatible = "qcom,tcsr";
			reg = <0x1949000 0x100>;
			qcom,wifi_glb_cfg = <TCSR_WIFI_GLB_CFG>;
		};
		tcsr@1957000 {
			compatible = "qcom,tcsr";
			reg = <0x1957000 0x100>;
			qcom,wifi_noc_memtype_m0_m2 = <TCSR_WIFI_NOC_MEMTYPE_M0_M2>;
		};
		ess_tcsr@1953000 {
			compatible = "qcom,tcsr";
			reg = <0x1953000 0x1000>;
			qcom,ess-interface-select = <TCSR_ESS_PSGMII>;
		};
		qcom_crypto: qcrypto@8e20000 {
			status = "okay";
		};

		qcom_cedev: qcedev@8e20000 {
			status = "okay";
		};
	};
};
&tlmm {
	serial_0_pins: serial_0_pinmux {
		pinmux {
			pins = "gpio16", "gpio17";
			function = "blsp_uart0";
			bias-disable;
		};
	};
	serial_1_pins: serial_1_pinmux {
		pinmux {
			pins = "gpio8", "gpio9", "gpio10", "gpio11";
			function = "blsp_uart1";
			bias-disable;
		};
	};
	spi_0_pins: spi_0_pinmux {
		pinmux {
			pins = "gpio13", "gpio14", "gpio15";
			function = "blsp_spi0";
			drive-strength = <12>;
			bias-disable;
		};
		pinmux_cs {
			pins = "gpio12";
			function = "gpio";
			drive-strength = <2>;
			bias-disable;
			output-high;
		};
	};
	i2c_0_pins: i2c_0_pinmux {
		pinmux {
			pins = "gpio20", "gpio21";
			function = "blsp_i2c0";
			drive-strength = <16>;
			bias-disable;
		};
	};
	wifi_0_pins: wifi1_pinmux {
		mux_1 {
			pins = "gpio37";
			output-high;
			function="gpio";
			bias-pull-up;
			drive-strength = <6>;
		};
		mux_2 {
			pins = "gpio43";
			function="gpio";
			bias-pull-up;
			drive-strength = <6>;
		};
		mux_3 {
			pins = "gpio52";
			output-high;
			function="gpio";
			bias-pull-up;
			drive-strength = <6>;
		};
	};

	sd_0_pins: sd_0_pinmux {
		sd0 {
			pins = "gpio23";
			function = "sdio";
			drive-strength = <10>;
		};
		sd1 {
			pins = "gpio24";
			function = "sdio";
			drive-strength = <10>;
		};
		sd2 {
			pins = "gpio25";
			function = "sdio";
			drive-strength = <10>;
		};
		sd3 {
			pins = "gpio26";
			function = "sdio";
			drive-strength = <10>;
		};
		sdclk {
			pins = "gpio27";
			function = "sdio";
			drive-strength = <16>;
		};
		sdcmd {
			pins = "gpio28";
			function = "sdio";
			drive-strength = <10>;
		};
    };
	ts_0_pins: ts_0_pinmux {
		mux_1 {
			pins = "gpio34";
			output-high;
		};
		mux_2 {
			pins= "gpio35";
			input-enable;
			bias-pull-up;
		};
	};
};
&blsp_dma {
	status = "okay";
};
&blsp1_i2c3 {
	pinctrl-0 = <&i2c_0_pins>;
	pinctrl-names = "default";
	status = "okay";
};
&blsp1_uart1 {
	pinctrl-0 = <&serial_0_pins>;
	pinctrl-names = "default";
	status = "okay";
};
&blsp1_uart2 {
	pinctrl-0 = <&serial_1_pins>;
	pinctrl-names = "default";
	status = "okay";
};
&qpic_bam {
	status = "okay";
};
&blsp1_spi1 {
	status = "okay";

	flash@0 {
		compatible = "jedec,spi-nor";
		reg = <0>;
		spi-max-frequency = <24000000>;

		partitions {
			compatible = "fixed-partitions";
			#address-cells = <1>;
			#size-cells = <1>;

			partition@0 {
				label = "0:SBL1";
				reg = <0x000000000000 0x30000>;
				read-only;
			};
			partition@000000030000 {
				label = "0:BOOTCONFIG";
				reg = <0x000000030000 0x10000>;
			};
			partition@40000 {
				label = "0:MIBIB";
				reg = <0x000000040000 0x10000>;
			};
			partition@50000 {
				label = "0:BOOTCONFIG1";
				reg = <0x000000050000 0x10000>;
			};
			partition@60000 {
				label = "0:QSEE";
				reg = <0x000000060000 0x60000>;
			};
			partition@c0000 {
				label = "0:CDT";
				reg = <0x0000000c0000 0x10000>;
			};
			partition@d0000 {
				label = "0:DDRPARAMS";
				reg = <0x0000000d0000 0x10000>;
			};
			partition@e0000 {
				label = "0:APPSBLENV";
				reg = <0x0000000e0000 0x10000>;
			};
			partition@f0000 {
				label = "0:APPSBL";
				reg = <0x0000000f0000 0x80000>;
			};
			partition@170000 {
				label = "0:ART";
				reg = <0x000000170000 0x10000>;
				// looks to be the same as in v2
				compatible = "nvmem-cells";
				precal_art_1000: precal@1000 {
					reg = <0x1000 0x2f20>;
				};
				precal_art_5000: precal@5000 {
					reg = <0x5000 0x2f20>;
				};
			};
			partition@180000 {
				label = "OPAQUE";
				compatible = "nvmem-cells";
				reg = <0x000000180000 0x150000>;
				macaddr_config_0: macaddr@0 {
					reg = <0x8 0x6>;
				};
			};
			partition@2d0000 {
				label = "0:HLOS";
				reg = <0x0000002d0000 0x10000>;
			};
			partition@2e0000 {
				label = "0:rootfs";
				reg = <0x0000002e0000 0x50000>;
			};
			partition@330000 {
				label = "0:APPSBL_1";
				reg = <0x000000330000 0x80000>;
			};
			partition@3b0000 {
				label = "1:HLOS";
				reg = <0x0000003b0000 0x10000>;
			};
			partition@3c0000 {
				label = "1:rootfs";
				reg = <0x0000003c0000 0x440000>;
			};
		};
	};
};
&vqmmc {
	regulator-min-microvolt = <1800000>;
	states = <3000000 0x3
			  1800000 0x1>;
	reg = <0x01948000 0x4>;
	mask = <0x3>;
	status = "okay";
};
&sdhci {
	status = "okay";
	cap-mmc-highspeed;
	max-frequency = <52000000>;
	pinctrl-0 = <&sd_0_pins>;
	pinctrl-names = "default";
	vqmmc-supply = <&vqmmc>;
	cd-gpios = <&tlmm 22 GPIO_ACTIVE_LOW>;
	sd-ldo-gpios = <&tlmm 33 GPIO_ACTIVE_LOW>;
};
&pcie0 {
	status = "okay";

	perst-gpio = <&tlmm 38 GPIO_ACTIVE_LOW>;
	wake-gpio = <&tlmm 50 GPIO_ACTIVE_LOW>;

	bridge@0,0 {
		reg = <0x00000000 0 0 0 0>;
		#address-cells = <3>;
		#size-cells = <2>;
		ranges;

		wifi2: wifi@1,0 {
			compatible = "qcom,ath10k";
			reg = <0x00010000 0 0 0 0>;
		};
	};
};
&crypto {
	status = "okay";
};
&cryptobam {
	status = "okay";
};
&usb2 {
	status = "okay";
};
&usb2_hs_phy {
	status = "okay";
};
&usb3 {
	status = "okay";
};
&usb3_hs_phy {
	status = "okay";
};
&usb3_ss_phy {
	status = "okay";
};
&mdio {
	status = "okay";
};
&watchdog {
	status = "okay";
};
&gmac {
	status = "okay";
};
&switch {
	status = "okay";
};
&swport4 {
	status = "okay";
	label = "lan";
	nvmem-cell-names = "mac-address";
	nvmem-cells = <&macaddr_config_0>;
};
&swport5 {
	status = "okay";
	label = "wan";
	nvmem-cell-names = "mac-address";
	nvmem-cells = <&macaddr_config_0>;
	mac-address-increment = <1>;
};

&wifi0 {
	pinctrl-0 = <&wifi_0_pins>;
	pinctrl-names = "default";
	btcoex_support = <1>;
	wlan_prio_gpio = <52>;
	status = "okay";
	nvmem-cell-names = "pre-calibration", "mac-address";
	nvmem-cells = <&precal_art_1000>, <&macaddr_config_0>;
	mac-address-increment = <2>;
};

&wifi1 {
	status = "okay";
	btcoex_support = <0>;
	nvmem-cell-names = "pre-calibration", "mac-address";
	nvmem-cells = <&precal_art_5000>, <&macaddr_config_0>;
	mac-address-increment = <3>;
	ieee80211-freq-limit = <5170000 5330000>;
};

&wifi2 {
	status = "okay";
	nvmem-cell-names = "pre-calibration", "mac-address";
	nvmem-cells = <&precal_art_5000>, <&macaddr_config_0>;
	mac-address-increment = <4>;
	ieee80211-freq-limit = <5490000 5835000>;
};
